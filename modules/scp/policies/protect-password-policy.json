{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyWeakenOrRemovePasswordPolicy",
      "Effect": "Deny",
      "Action": [
        "iam:UpdateAccountPasswordPolicy",
        "iam:DeleteAccountPasswordPolicy"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalTag/ops-tree:iam-admin": "true"
        }
      }
    }
  ]
}